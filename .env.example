# Holma Environment Variables
# Copy this to .env and fill in your values

# Server
FLASK_ENV=production
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep this value unchanged or encrypted credentials can no longer be read.
SECRET_KEY=
DEBUG=false
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false

# Ports
API_PORT=5000
FRONTEND_PORT=3000

# CORS - Allowed origins (comma-separated)
# For production, set to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backup
BACKUP_BASE_PATH=/mnt/backup
MAX_PARALLEL_TASKS=2
LOG_RETENTION_DAYS=30
DOCKER_HELPER_IMAGE=alpine:3.24.1

# Source and notification credentials are managed in Settings → Credentials.
# They are encrypted in the database; environment variables are only a legacy
# fallback for custom deployments that explicitly pass them into the container.
