# Holma Configuration
# Copy this file to .env and adjust values

# Server Configuration
FLASK_ENV=production
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep this value unchanged or encrypted credentials can no longer be read.
SECRET_KEY=
DEBUG=false
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0

# Frontend Configuration
FRONTEND_PORT=3000

# Backup Configuration
BACKUP_BASE_PATH=/mnt/backup
MAX_PARALLEL_TASKS=auto
LOG_RETENTION_DAYS=30
DOCKER_HELPER_IMAGE=alpine:3.24.1

# Data Paths (für persistente Daten, z.B. Synology: /volume1/docker/holma/...)
# CONFIG_PATH=./config
# DATA_PATH=./data
# LOGS_PATH=./logs

# Database (SQLite by default)
DATABASE_URL=sqlite:////data/backupgenie.db

# Platform Configuration
# auto = detect hardware automatically at container start
# Options: auto, raspberrypi, synology, server
PLATFORM_PROFILE=auto

# Resource Limits (adjust for your hardware)
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=1G
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256M

# Source and notification credentials are managed in Settings → Credentials.
# They are encrypted in the database; environment variables are only a legacy
# fallback for custom deployments that explicitly pass them into the container.

# --- Backup Scheduler ---
# Timezone for scheduled backups. "03:00" means 03:00 local wall clock.
TZ=Europe/Berlin
# Set to false to disable time-based scheduling entirely
SCHEDULER_ENABLED=true
