{
  "backup_sources": [
    {
      "id": "local-docs",
      "name": "Local documents",
      "type": "local",
      "enabled": false,
      "priority": 1,
      "sources": ["/data/example-source"],
      "options": {
        "delete": false,
        "follow_symlinks": false
      }
    },
    {
      "id": "nas-smb",
      "name": "NAS through SMB",
      "type": "nas",
      "enabled": false,
      "priority": 2,
      "config": {
        "host": "diskstation",
        "share": "backupgenie-test",
        "path": "optional/subfolder",
        "username": "backupgenie",
        "credentials": {
          "password_env": "SMB_PASSWORD"
        },
        "options": {
          "encrypt_transport": false,
          "timeout": 3600
        }
      }
    },
    {
      "id": "nas-rsync",
      "name": "NAS through rsync/SSH",
      "type": "rsync-ssh",
      "enabled": false,
      "priority": 3,
      "config": {
        "host": "diskstation",
        "port": 22,
        "path": "/volume1/backupgenie-test",
        "username": "backupgenie",
        "ssh_key_path": "/run/secrets/backupgenie_ssh_key",
        "options": {
          "delete": false,
          "strict_host_key_checking": true
        }
      }
    },
    {
      "id": "github-repositories",
      "name": "GitHub repositories",
      "type": "github",
      "enabled": false,
      "priority": 4,
      "repositories": ["owner/repository"],
      "credentials": {
        "token_env": "GITHUB_TOKEN"
      },
      "options": {
        "include_lfs": true,
        "include_wikis": true,
        "include_releases": true
      }
    },
    {
      "id": "postgres-main",
      "name": "PostgreSQL",
      "type": "postgresql",
      "enabled": false,
      "priority": 5,
      "config": {
        "host": "postgres",
        "port": 5432,
        "databases": ["app"],
        "credentials": {
          "username_env": "POSTGRES_USER",
          "password_env": "POSTGRES_PASSWORD"
        }
      }
    },
    {
      "id": "docker-data",
      "name": "Docker volume",
      "type": "docker-volume",
      "enabled": false,
      "priority": 6,
      "config": {
        "volumes": ["myapp_data"],
        "options": {
          "stop_containers": false
        }
      }
    },
    {
      "id": "portainer-stacks",
      "name": "Portainer stacks",
      "type": "portainer",
      "enabled": false,
      "priority": 7,
      "config": {
        "host": "diskstation",
        "port": 9443,
        "https": true,
        "backup_method": "api",
        "credentials": {
          "api_key_env": "PORTAINER_API_KEY"
        },
        "options": {
          "verify_ssl": true
        }
      }
    },
    {
      "id": "supabase-project",
      "name": "Supabase project",
      "type": "supabase",
      "enabled": false,
      "priority": 8,
      "config": {
        "connection_string": "postgresql://postgres.PROJECT:[YOUR-PASSWORD]@HOST:5432/postgres",
        "service_role_key": "store through encrypted settings instead of committing a real key",
        "backup_mode": "full",
        "options": {
          "include_storage": true,
          "include_auth_config": true,
          "compress": true
        }
      }
    }
  ]
}
